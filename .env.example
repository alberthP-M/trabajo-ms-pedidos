MS_CATALOGO_DATABASE_URL=postgres://catalogo:catalogo@localhost:5432/catalogo_db
MS_PEDIDOS_DATABASE_URL=postgres://pedidos:pedidos@localhost:5432/pedidos_db
MS_PAGOS_DATABASE_URL=postgres://pagos:pagos@localhost:5432/pagos_db

MS_AUTH_URL=http://localhost:3005
MS_CATALOGO_URL=http://localhost:3001
MS_PEDIDOS_URL=http://localhost:3002
MS_PAGOS_URL=http://localhost:3003
PAYMENT_STUB_URL=http://localhost:3004

ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=7
SEED_CLIENT_PASSWORD=cliente123
SEED_BRANCH_PASSWORD=sucursal123

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=trabajo-pedidos
